NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Paste both connection strings from the same Prisma Postgres database.
# The API uses the pooled URL; Prisma CLI migrations use the direct URL.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Optional: only for `prisma migrate dev` when authoring a new migration.
# This must point to a separate disposable database, never the main database.
# SHADOW_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Host port for the Next.js dev server (3000 is often taken)
WEB_PORT=3100

# Browser-facing API base URL (used by the Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Comma-separated origins allowed to call the API from the browser
CORS_ORIGIN=http://localhost:3100
