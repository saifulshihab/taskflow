NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Printed by `npx prisma@prev dev` on the host. Keep the query params as given.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Same two databases with localhost swapped for host.docker.internal, so the
# dev container can reach them. docker-compose.yml maps these onto
# DATABASE_URL / SHADOW_DATABASE_URL inside the container.
DATABASE_URL_CONTAINER="postgres://postgres:postgres@host.docker.internal:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
SHADOW_DATABASE_URL_CONTAINER="postgres://postgres:postgres@host.docker.internal:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Host port for the Next.js dev server (3000 is often taken)
WEB_PORT=3100
